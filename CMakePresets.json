{
  "version": 5,
  "configurePresets": [
    {
      "name": "gcc16",
      "displayName": "GCC 16 C++26",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "gcc16-sanitizers",
      "displayName": "GCC 16 C++26 ASan/UBSan",
      "inherits": "gcc16",
      "binaryDir": "${sourceDir}/build-sanitizers",
      "cacheVariables": {
        "POLYMORPHISM_SANITIZERS": "ON"
      }
    },
    {
      "name": "gcc16-coverage",
      "displayName": "GCC 16 C++26 coverage",
      "inherits": "gcc16",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "POLYMORPHISM_COVERAGE": "ON"
      }
    },
    {
      "name": "gcc16-benchmarks",
      "displayName": "GCC 16 C++26 benchmarks",
      "inherits": "gcc16",
      "binaryDir": "${sourceDir}/build-benchmarks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc16",
      "configurePreset": "gcc16"
    },
    {
      "name": "gcc16-sanitizers",
      "configurePreset": "gcc16-sanitizers"
    },
    {
      "name": "gcc16-coverage",
      "configurePreset": "gcc16-coverage"
    },
    {
      "name": "gcc16-benchmarks",
      "configurePreset": "gcc16-benchmarks"
    }
  ]
}
